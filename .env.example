# Copy this file to .env and fill in real values before starting the server.
# NEVER commit the real .env file to git.

# Required: Admin password for the data-editor UI.
# Use a strong random string. The server will refuse to start if this is not set.
ADMIN_PASSWORD=your-secure-password-here

# Required: Secret used to sign session cookies.
# Use a long random string (e.g. openssl rand -hex 32).
# The server will refuse to start if this is not set.
SESSION_SECRET=your-long-random-secret-here

# Optional: Set to 'production' to enable secure cookies (requires HTTPS).
# NODE_ENV=production

# Optional: Override the default port (3000).
# PORT=3000
